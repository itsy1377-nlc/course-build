    "content:payment_timing_request"
  ],
  "prior_similar_report_rule": {
    "description": "The rule behind recipient:prior_similar_report, since a benign email carries no campaign tag of its own. Take every ask code present in the indicators and collect the campaign tags it maps to in ask_to_campaign_tags. Add the sender reputation record's campaign_tag when that tag is listed in sender_campaign_tags. The indicator is present when any collected tag appears in the recipient record's prior_reports, and its value is the first such tag in value_order. Credential, data and banking asks map to no tag: a prior credential-phish report is the ordinary state of a mailbox and says nothing about the message in hand, while a prior payment-fraud or executive-impersonation report on the same mailbox is the context the playbook's callback rules use. tools/check_spec.py recomputes this for every record.",
    "ask_to_campaign_tags": {
      "content:payment_change_request": [
        "vendor-invoice-fraud",
        "direct-deposit-change"
      ],
      "content:payment_timing_request": [
        "vendor-invoice-fraud"
      ],
      "content:gift_card_request": [
        "ceo-impersonation",
        "cfo-impersonation"
      ],
      "content:credential_request": [],
      "content:data_request": [],
      "content:banking_instruction": []
    },
    "sender_campaign_tags": [
      "ceo-impersonation",
      "cfo-impersonation"
    ],
    "value_order": [
      "vendor-invoice-fraud",
      "direct-deposit-change",
      "ceo-impersonation",
      "cfo-impersonation"
    ]
  },
