# The recording container.
#
# Derived from the image students actually develop in, not from the VHS image.
# That costs a few extra layers and buys the thing that matters: the shell in
# the walkthrough is the shell the student has, same Debian, same Python 3.12,
# same package versions. A recording made in a different environment teaches a
# workflow the student cannot reproduce.
#
# It also solves a problem found the hard way. Running VHS on the host picked up
# the host prompt, conda prefix and all. A container has no dotfiles to inherit.
FROM mcr.microsoft.com/devcontainers/python:3.12-bookworm

ARG VHS_VERSION=0.11.0
ARG TTYD_VERSION=1.7.7

# chromium is not optional. VHS rasterizes the terminal by driving a headless
# browser through go-rod and screenshotting it, so without a browser binary it
# fails at render time with a download error rather than at build time. Debian
# ships an arm64 chromium, which avoids go-rod trying to fetch one at runtime
# inside a container that may have no network.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg fonts-jetbrains-mono ca-certificates curl chromium \
    && rm -rf /var/lib/apt/lists/*

# ttyd and vhs both publish static arm64 and amd64 builds.
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      arm64) ttyd_arch=aarch64; vhs_arch=arm64 ;; \
      amd64) ttyd_arch=x86_64;  vhs_arch=amd64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /usr/local/bin/ttyd \
      "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${ttyd_arch}" \
 && chmod +x /usr/local/bin/ttyd \
 && curl -fsSL -o /tmp/vhs.tar.gz \
      "https://github.com/charmbracelet/vhs/releases/download/v${VHS_VERSION}/vhs_${VHS_VERSION}_Linux_${vhs_arch}.tar.gz" \
 && tar -xzf /tmp/vhs.tar.gz -C /tmp \
 && find /tmp -name vhs -type f -exec mv {} /usr/local/bin/vhs \; \
 && chmod +x /usr/local/bin/vhs \
 && rm -rf /tmp/vhs*

# The lab dependencies, installed the same way the devcontainer installs them,
# so a command that works for a student works here.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LAB_STUDENT_ID=walkthrough \
    ROD_BROWSER_BIN=/usr/bin/chromium \
    VHS_NO_SANDBOX=true
WORKDIR /work
